# Unified COMSOL MCP Server configuration template
# Copy to .env or pass via your MCP client's "env" block.

# Comma-separated tool profiles to expose:
#   core, physics, batch, gui, catalog, validate, rag, dryrun, or "all"
COMSOL_MCP_PROFILES=all

# COMSOL installation root (Multiphysics folder, not bin/win64). Auto-detected if omitted.
# COMSOL_HOME=C:/Program Files/COMSOL/COMSOL62/Multiphysics

# Default workspace directory for saved models & batch job artifacts
# COMSOL_MCP_WORKSPACE=./models

# Default CPU cores for mph/batch sessions
COMSOL_MCP_CORES=2

# Start in dry-run simulator mode without requiring a COMSOL license (true/false)
COMSOL_MCP_DRYRUN=false

# Local offline catalog cache directory (populated via `comsol-mcp catalog-build`)
# COMSOL_MCP_CATALOG_DIR=./catalog_cache

# Optional PDF RAG settings (docs are never committed to git)
# COMSOL_MCP_PDF_DIR=./pdf
# COMSOL_MCP_KNOWLEDGE_DIR=./knowledge_base
# Embedding provider: "local" (sentence-transformers) or "api" (OpenAI-compatible / DashScope)
COMSOL_MCP_EMBEDDING_PROVIDER=local
COMSOL_MCP_EMBEDDING_MODEL=all-MiniLM-L6-v2
# For API embeddings (DashScope, OpenAI, etc.):
# COMSOL_MCP_EMBEDDING_API_KEY=
# COMSOL_MCP_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# COMSOL_MCP_EMBEDDING_DIMENSION=1024

# Lightweight web status dashboard port (`comsol-mcp web`)
COMSOL_MCP_WEB_PORT=8765
